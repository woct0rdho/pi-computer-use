{
	"name": "@injaneity/pi-computer-use",
	"version": "0.5.1",
	"description": "Pi extension that lets AI agents observe and control Windows apps.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"computer-use",
		"windows",
		"desktop-automation",
		"accessibility"
	],
	"license": "MIT",
	"packageManager": "pnpm@12.8.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/injaneity/pi-computer-use.git"
	},
	"bugs": {
		"url": "https://github.com/injaneity/pi-computer-use/issues"
	},
	"homepage": "https://github.com/injaneity/pi-computer-use#readme",
	"engines": {
		"node": ">=22.19.0",
		"pnpm": ">=10"
	},
	"files": [
		"extensions",
		"src",
		"scripts/build-native.mjs",
		"scripts/setup-helper.mjs",
		"native/windows/bridge-rs/Cargo.lock",
		"native/windows/bridge-rs/Cargo.toml",
		"native/windows/bridge-rs/src",
		"native/windows/bridge-rs/tests",
		"prebuilt/windows",
		"assets/reference/img.jpg",
		"README.md",
		"LICENSE",
		"docs/*.md"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "./assets/reference/img.jpg"
	},
	"scripts": {
		"postinstall": "node scripts/setup-helper.mjs --postinstall",
		"typecheck": "tsc -p tsconfig.json",
		"test:schema": "tsx scripts/check-tool-schemas.mjs",
		"test:invariants": "tsx scripts/check-invariants.mjs",
		"test:runtime": "tsx scripts/check-runtime-concurrency.mjs",
		"test:output": "tsx scripts/check-bounded-output.mjs",
		"test:commits": "node scripts/check-commit-messages.mjs",
		"test:platform": "tsx scripts/check-platform.mjs",
		"test:build-scripts": "node scripts/check-build-scripts.mjs",
		"test:package-assets": "node scripts/check-package-assets.mjs",
		"test": "pnpm run typecheck && pnpm run test:schema && pnpm run test:output && pnpm run test:runtime && pnpm run test:invariants && pnpm run test:platform && pnpm run test:build-scripts",
		"build:native": "node scripts/build-native.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	}
}
